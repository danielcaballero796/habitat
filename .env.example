# Copy to .env and adjust as needed. .env is gitignored; this file is not.
# All variables here have safe dev defaults in docker-compose.yml — you only
# need a .env file to override them.

# Postgres password used by the db and app services (defaults to habitat_dev).
POSTGRES_PASSWORD=habitat_dev

# Secret used to sign JWTs issued by JwtService. Defaults to a clearly-fake
# dev value in docker-compose.yml. Set a real random value if this app is
# ever reachable beyond localhost.
JWT_SECRET=dev_jwt_secret_change_me_in_production

# Rails master key, used to decrypt config/credentials.yml.enc. Only needed
# if you rely on encrypted credentials (e.g. credentials.jwt_secret) instead
# of the JWT_SECRET env var above. Leave blank for local dev.
RAILS_MASTER_KEY=
