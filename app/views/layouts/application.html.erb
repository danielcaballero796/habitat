<!DOCTYPE html>
<html>
  <head>
    <title>Habitat Dashboard</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <%= stylesheet_link_tag "modal" %>
    <%= stylesheet_link_tag "dashboard" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <% if logged_in? %>
      <nav class="d-flex justify-content-end p-2">
        <%= button_to "Logout", logout_path, method: :delete, class: "btn btn-outline-secondary btn-sm" %>
      </nav>
    <% end %>
    <%= yield %>

    <%# Loaded at body end (Bootstrap's own recommendation) purely for
        utility JS bundled features used elsewhere (e.g. tooltips/collapse,
        if ever needed). NOTE: this app's own modal component (shared/_modal
        + the Stimulus `modal` controller) intentionally does NOT use
        Bootstrap's JS modal system — only Bootstrap's CSS utility classes
        (btn, table, badge, etc). See app/assets/stylesheets/modal.css for
        why the class names are kept distinct from Bootstrap's own
        `.modal`/`.modal-backdrop`. %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
