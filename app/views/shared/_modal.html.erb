<%# Reusable modal component.
    Locals:
      id      - unique DOM id for the modal overlay (e.g. "device-modal")
      title   - heading text shown in the modal header
      open    - optional; when true, the modal renders already visible
                (used for full-page navigations to /new and /edit)
      data    - optional hash of extra data-* attributes merged onto the
                overlay div (e.g. { "confirm-delete-target": "modal" }, used
                by the confirm-delete Stimulus controller)
      content - block yielded as the modal body (form, confirmation text, etc.) %>
<%# `tag.attributes` renders hash keys as literal attribute names, so a raw
    key like "confirm-delete-target" would render as
    confirm-delete-target="modal" (missing the "data-" prefix Stimulus
    requires to recognize it as a target) unless we prefix it ourselves. %>
<% extra_data_attributes = (local_assigns[:data] || {}).transform_keys { |key| "data-#{key}" } %>
<div id="<%= id %>" class="modal-overlay<%= " open" if local_assigns[:open] %>" data-controller="modal"<%= " #{tag.attributes(extra_data_attributes)}".html_safe if extra_data_attributes.present? %>>
  <div class="modal-backdrop" data-action="click->modal#closeOnBackdrop"></div>
  <div class="modal-content">
    <div class="modal-header">
      <h2><%= title %></h2>
      <button type="button" class="modal-close" data-action="click->modal#close" aria-label="Close">
        &times;
      </button>
    </div>
    <div class="modal-body">
      <%= yield %>
    </div>
  </div>
</div>

<%# Minimal functional styling (display toggle only). Phase 8 replaces this
    with app/assets/stylesheets/modal.css including animations/polish. %>
<style>
  .modal-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 1000;
  }

  .modal-overlay.open {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Bootstrap (loaded globally via CDN in the layout) ships its OWN
     `.modal-backdrop` class with `position: fixed; inset: 0; z-index: 1050`
     for its own JS modal component. Our custom modal reuses the same class
     name for an unrelated "click outside to close" div, so without this
     override Bootstrap's rule makes it cover the full viewport and sit
     ABOVE `.modal-content` (which has no explicit z-index, i.e. z-index:
     auto within this stacking context) — swallowing every click inside the
     modal, including the submit button. Reset it back to a plain
     non-positioned, non-stacked child so `.modal-content` (explicitly
     stacked above it) receives clicks as expected. */
  .modal-backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: transparent;
  }

  .modal-content {
    position: relative;
    z-index: 1;
    background: white;
    border-radius: 8px;
    width: 90%;
    max-width: 500px;
    max-height: 90vh;
    overflow-y: auto;
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    border-bottom: 1px solid #e5e7eb;
  }

  .modal-close {
    background: none;
    border: none;
    font-size: 28px;
    cursor: pointer;
    color: #6b7280;
  }

  .modal-body {
    padding: 20px;
  }
</style>
