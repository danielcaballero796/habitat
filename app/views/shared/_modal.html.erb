<%# Reusable modal component.
    Locals:
      id      - unique DOM id for the modal overlay (e.g. "device-modal")
      title   - heading text shown in the modal header
      content - block yielded as the modal body (form, confirmation text, etc.) %>
<div id="<%= id %>" class="modal-overlay" data-controller="modal">
  <div class="modal-backdrop" data-action="click->modal#closeOnBackdrop"></div>
  <div class="modal-content">
    <div class="modal-header">
      <h2><%= title %></h2>
      <button type="button" class="modal-close" data-action="click->modal#close" aria-label="Close">
        &times;
      </button>
    </div>
    <div class="modal-body">
      <%= yield %>
    </div>
  </div>
</div>

<%# Minimal functional styling (display toggle only). Phase 8 replaces this
    with app/assets/stylesheets/modal.css including animations/polish. %>
<style>
  .modal-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 1000;
  }

  .modal-overlay.open {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .modal-content {
    background: white;
    border-radius: 8px;
    width: 90%;
    max-width: 500px;
    max-height: 90vh;
    overflow-y: auto;
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    border-bottom: 1px solid #e5e7eb;
  }

  .modal-close {
    background: none;
    border: none;
    font-size: 28px;
    cursor: pointer;
    color: #6b7280;
  }

  .modal-body {
    padding: 20px;
  }
</style>
