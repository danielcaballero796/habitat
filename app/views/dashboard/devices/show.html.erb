<div class="dashboard-container device-detail">
  <header class="dashboard-header d-flex justify-content-between align-items-center" data-controller="confirm-delete">
    <h1><%= @device.name %></h1>
    <div class="actions">
      <%= link_to "Back", dashboard_devices_path, class: "btn btn-secondary" %>
      <%= link_to "Edit", edit_dashboard_device_path(@device), class: "btn btn-warning" %>
      <%= link_to "Delete", "#", class: "btn btn-danger",
          data: { action: "click->confirm-delete#show", delete_url: dashboard_device_path(@device), delete_name: @device.name } %>
    </div>

    <%= render layout: "shared/modal", locals: { id: "confirm-delete-modal", title: "Confirm Delete", data: { "confirm-delete-target": "modal" } } do %>
      <%= render "delete_confirmation" %>
    <% end %>
  </header>

  <div id="flash"><%= render "shared/flash", message: flash[:notice] %></div>

  <div class="device-info">
    <p><strong>Type:</strong> <%= @device.type %></p>
    <p><strong>Brand:</strong> <%= @device.brand %></p>
    <p><strong>Model:</strong> <%= @device.model %></p>
    <p><strong>Room:</strong> <%= @device.room %></p>
    <p><strong>Status:</strong> <%= @device.status %></p>
    <p><strong>IP Address:</strong> <%= @device.ip_address %></p>
    <p><strong>MAC Address:</strong> <%= @device.mac_address %></p>
    <p><strong>Firmware Version:</strong> <%= @device.firmware_version %></p>
    <p><strong>Purchase Date:</strong> <%= @device.purchase_date %></p>
    <p><strong>Notes:</strong> <%= @device.notes %></p>
  </div>

  <div class="attributes-section" data-controller="confirm-delete">
    <header class="d-flex justify-content-between align-items-center">
      <h3>Device Attributes</h3>
      <%= link_to "+ Add Attribute", new_dashboard_device_device_attribute_path(@device), class: "btn btn-primary",
          data: { controller: "modal-trigger", action: "click->modal-trigger#open", "modal-trigger-modal-outlet": "#attribute-modal" } %>
    </header>

    <table class="table attributes-table">
      <thead>
        <tr>
          <th>Key</th>
          <th>Value</th>
          <th>Updated At</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody id="attributes-list">
        <% if @device.device_attributes.any? %>
          <%= render partial: "dashboard/device_attributes/attribute", collection: @device.device_attributes, as: :attribute %>
        <% else %>
          <tr id="no-attributes-row">
            <td colspan="4" class="empty-state">
              No attributes yet.
              <%= link_to "Add one", new_dashboard_device_device_attribute_path(@device),
                  data: { controller: "modal-trigger", action: "click->modal-trigger#open", "modal-trigger-modal-outlet": "#attribute-modal" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <%= render layout: "shared/modal", locals: { id: "attribute-modal", title: "Add Attribute" } do %>
      <%= render "dashboard/device_attributes/form", device: @device, attribute: DeviceAttribute.new %>
    <% end %>

    <%= render layout: "shared/modal", locals: { id: "confirm-delete-attribute-modal", title: "Confirm Delete", data: { "confirm-delete-target": "modal" } } do %>
      <%= render "dashboard/device_attributes/delete_confirmation" %>
    <% end %>
  </div>
</div>
