<tr id="device-<%= device.id %>">
  <td><strong><%= device.name %></strong></td>
  <td><%= device.type %></td>
  <td>
    <% if device.status.present? %>
      <span class="badge bg-secondary"><%= device.status %></span>
    <% end %>
  </td>
  <td class="actions">
    <%= link_to "View", dashboard_device_path(device), class: "btn btn-sm btn-secondary" %>
    <%= link_to "Edit", edit_dashboard_device_path(device), class: "btn btn-sm btn-warning" %>
    <%= link_to "Delete", "#", class: "btn btn-sm btn-danger",
        data: { action: "click->confirm-delete#show", delete_url: dashboard_device_path(device), delete_name: device.name } %>
  </td>
</tr>
