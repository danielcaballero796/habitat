<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
      <div class="card">
        <div class="card-body">
          <h1 class="card-title text-center h4 mb-4">Log In</h1>

          <% if flash[:alert] %>
            <div class="alert alert-danger"><%= flash[:alert] %></div>
          <% end %>
          <% if flash[:notice] %>
            <div class="alert alert-info"><%= flash[:notice] %></div>
          <% end %>

          <%= form_with url: login_path, method: :post, local: true do |f| %>
            <div class="mb-3">
              <%= f.label :email, class: "form-label" %>
              <%= f.email_field :email, class: "form-control", required: true, autofocus: true %>
            </div>
            <div class="mb-3">
              <%= f.label :password, class: "form-label" %>
              <%= f.password_field :password, class: "form-control", required: true %>
            </div>
            <%= f.submit "Log In", class: "btn btn-primary w-100" %>
          <% end %>

          <p class="text-center mt-3">
            <%= link_to "Back to homepage", "/" %>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
